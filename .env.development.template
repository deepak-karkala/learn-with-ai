# Development Environment Configuration Template
# Copy this file to .env.development and fill in your development values

# =============================================================================
# IMPORTANT: This is for DEVELOPMENT only - use .env.production.template for production
# =============================================================================

# Environment
ENVIRONMENT=development
NODE_ENV=development

# =============================================================================
# Security Level (more permissive for development)
# =============================================================================
SECURITY_LEVEL=development

# =============================================================================
# Google ADK Configuration (REQUIRED)
# =============================================================================

# Use Google AI Studio for development (simpler setup)
GOOGLE_API_KEY=your_google_api_key_here

# ADK Agent Configuration (development defaults)
ADK_MODEL_NAME=gemini-2.0-flash-exp
ADK_STREAMING_TIMEOUT=30.0
ADK_MAX_EVENTS=100
ADK_MAX_CONNECTIONS=5
ADK_CONNECTION_HEALTH_TIMEOUT=300.0
ADK_SESSION_EXPIRY_SECONDS=3600.0

# =============================================================================
# OpenAI Configuration (REQUIRED for multimodal analysis)
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# Database Configuration (Local/Test)
# =============================================================================

# Local PostgreSQL for development
DATABASE_URL=postgresql://username:password@localhost:5432/systemdesign_ai_dev

# =============================================================================
# Redis Configuration (Local)
# =============================================================================

# Local Redis for development
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Authentication & Authorization (Development Settings)
# =============================================================================

# JWT Configuration (less strict for development)
JWT_SECRET=dev_jwt_secret_change_this_in_production_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Login Security (lenient for development)
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_DURATION_MINUTES=5

# API Key Authentication
ENABLE_API_KEY_AUTH=true

# =============================================================================
# Data Encryption (Development)
# =============================================================================

# Development encryption key
ENCRYPTION_KEY=dev_encryption_key_32_characters
ENCRYPT_SENSITIVE_DATA=true
KEY_ROTATION_DAYS=365

# =============================================================================
# Rate Limiting (Relaxed for Development)
# =============================================================================

ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST_SIZE=20
STRICT_RATE_LIMITING=false

# =============================================================================
# Security Monitoring (Enabled but Less Strict)
# =============================================================================

ENABLE_THREAT_DETECTION=true
ENABLE_PII_DETECTION=true
ENABLE_INPUT_VALIDATION=true
ENABLE_SECURITY_HEADERS=true
ENABLE_HSTS=false
ENABLE_CSP=false

# Security Logging
LOG_SECURITY_EVENTS=true
ALERT_ON_HIGH_THREATS=false
FAILURE_THRESHOLD=10

# =============================================================================
# CORS (Permissive for Development)
# =============================================================================

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# =============================================================================
# Application Configuration
# =============================================================================

API_TITLE=AI System Design Learning Platform API (Dev)
API_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=DEBUG

# Development ports
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# Frontend Configuration
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development

# =============================================================================
# Monitoring (Optional for Development)
# =============================================================================

# Opik for development (optional)
# OPIK_API_KEY=your_dev_opik_key
# OPIK_PROJECT_NAME=systemdesign-ai-dev

# Disable expensive monitoring in development
ENABLE_COST_TRACKING=false
ENABLE_PERFORMANCE_MONITORING=false
ENABLE_ERROR_TRACKING=true

# =============================================================================
# Storage (Local for Development)
# =============================================================================

# Local storage instead of GCS
STORAGE_TYPE=local
STORAGE_PATH=./storage

# =============================================================================
# Feature Flags (Enable All for Development)
# =============================================================================

ENABLE_VOICE_FEATURES=true
ENABLE_DIAGRAM_GENERATION=true
ENABLE_ASSESSMENT_SYSTEM=true
ENABLE_PROGRESS_TRACKING=true
ENABLE_DEBUG_ENDPOINTS=true
ENABLE_DOCS=true

# =============================================================================
# Development Tools
# =============================================================================

# Hot reload
RELOAD=true

# Enable all debugging
ENABLE_REDOC=true
ENABLE_DEBUG_TOOLBAR=true

# Testing
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/systemdesign_ai_test
TEST_REDIS_URL=redis://localhost:6379/1

# =============================================================================
# Quick Setup Notes for Development
# =============================================================================

# 1. Install dependencies:
#    cd backend && pip install -r requirements.txt
#    cd frontend && npm install

# 2. Start local services:
#    # PostgreSQL: brew install postgresql && brew services start postgresql
#    # Redis: brew install redis && brew services start redis

# 3. Create database:
#    createdb systemdesign_ai_dev
#    createdb systemdesign_ai_test

# 4. Copy this file to .env.development and update the API keys

# 5. Run the application:
#    cd backend && uvicorn app.main:app --reload
#    cd frontend && npm run dev