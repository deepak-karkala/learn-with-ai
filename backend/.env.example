# Example environment variables for the backend
# Copy this file to .env and fill in the values

# Google ADK Configuration (following ADK streaming documentation)
# Choose either Google AI Studio OR Google Cloud Vertex AI

# Option 1: Google AI Studio (recommended for development)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-google-ai-api-key

# Option 2: Google Cloud Vertex AI (for production)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Application Configuration
DEBUG=True
LOG_LEVEL=INFO

# Future Configuration (for later phases)
# DATABASE_URL=postgresql://user:pass@localhost/dbname
# REDIS_URL=redis://localhost:6379
# JWT_SECRET=your-jwt-secret
# ENCRYPTION_KEY=your-encryption-key