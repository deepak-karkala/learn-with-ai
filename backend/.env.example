# Example environment variables for the backend
# Copy this file to .env and fill in the values

# Google ADK Configuration (following ADK streaming documentation)
# Choose either Google AI Studio OR Google Cloud Vertex AI

# Option 1: Google AI Studio (recommended for development)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=

# Option 2: Google Cloud Vertex AI (for production)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# ADK Agent Configuration
ADK_MODEL_NAME=gemini-2.0-flash-exp
ADK_STREAMING_TIMEOUT=30.0
ADK_MAX_EVENTS=100
ADK_MAX_CONNECTIONS=10
ADK_CONNECTION_HEALTH_TIMEOUT=300.0

# Application Configuration
DEBUG=True
LOG_LEVEL=INFO

# Future Configuration (for later phases)
# DATABASE_URL=postgresql://user:pass@localhost/dbname
# REDIS_URL=redis://localhost:6379
# JWT_SECRET=your-jwt-secret
# ENCRYPTION_KEY=your-encryption-key