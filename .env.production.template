# Production Environment Configuration Template
# Copy this file to .env.production and fill in the actual values

# =============================================================================
# CRITICAL: Never commit actual values to version control
# =============================================================================

# Environment
ENVIRONMENT=production

# =============================================================================
# Google ADK Configuration (REQUIRED)
# =============================================================================

# Option 1: Use Google AI Studio (Simpler setup)
GOOGLE_API_KEY=your_google_api_key_here

# Option 2: Use Vertex AI (More enterprise features)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ADK Agent Configuration
ADK_MODEL_NAME=gemini-2.0-flash-exp
ADK_STREAMING_TIMEOUT=30.0
ADK_MAX_EVENTS=100
ADK_MAX_CONNECTIONS=10
ADK_CONNECTION_HEALTH_TIMEOUT=300.0
ADK_SESSION_EXPIRY_SECONDS=3600.0

# =============================================================================
# OpenAI Configuration (REQUIRED for multimodal analysis)
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here

# Multimodal Analysis Settings
MULTIMODAL_MODEL_NAME=gpt-4o
MULTIMODAL_ANALYSIS_TIMEOUT=60.0
MULTIMODAL_MAX_TOKENS=4000
MULTIMODAL_TEMPERATURE=0.1

# Assessment Configuration
ASSESSMENT_MODEL_NAME=gpt-4-1106-preview
ASSESSMENT_MAX_TOKENS=2000
ASSESSMENT_TEMPERATURE=0.1

# =============================================================================
# Database Configuration (REQUIRED for production)
# =============================================================================

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database
# Example for Neon: postgresql://user:pass@ep-xyz.us-east-1.aws.neon.tech/dbname
DATABASE_URL=postgresql://username:password@host:port/database_name

# Database Connection Pool Settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# =============================================================================
# Redis Configuration (REQUIRED for production)
# =============================================================================

# Redis URL for caching and rate limiting
# Format: redis://username:password@host:port/database
# Example for Upstash: redis://default:password@region.upstash.io:port
REDIS_URL=redis://username:password@host:port/0

# Redis Settings
REDIS_MAX_CONNECTIONS=10
REDIS_RETRY_ON_TIMEOUT=true
REDIS_SOCKET_KEEPALIVE=true

# =============================================================================
# Google Cloud Storage (REQUIRED for artifacts)
# =============================================================================

# GCS Bucket for storing session artifacts and whiteboards
GCS_BUCKET_NAME=your-production-bucket-name

# GCS Configuration
GCS_REGION=us-central1
GCS_STORAGE_CLASS=STANDARD

# If using service account (recommended for production)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# =============================================================================
# Vertex AI RAG Configuration (OPTIONAL but recommended)
# =============================================================================

# Vertex AI Vector Search for memory service
VERTEX_AI_INDEX_ID=your_vector_index_id
VERTEX_AI_INDEX_ENDPOINT_ID=your_index_endpoint_id
VERTEX_AI_DEPLOYED_INDEX_ID=your_deployed_index_id

# Vector Search Configuration
VECTOR_SEARCH_DIMENSIONS=768
VECTOR_SEARCH_SIMILARITY_THRESHOLD=0.7

# =============================================================================
# Monitoring and Observability (REQUIRED for production)
# =============================================================================

# Comet Opik for LLM monitoring
OPIK_API_KEY=your_opik_api_key_here
OPIK_PROJECT_NAME=systemdesign-ai-production
OPIK_WORKSPACE=your_workspace_name

# Application Insights / Monitoring
ENABLE_COST_TRACKING=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_ERROR_TRACKING=true

# Cost Tracking Configuration
MULTIMODAL_COST_PER_1K_TOKENS=0.005
MULTIMODAL_COST_PER_IMAGE=0.01

# Alerting Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-alert-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_RECIPIENTS=admin@yourcompany.com,devops@yourcompany.com

# Alert Thresholds (optional - defaults will be used if not set)
ALERT_THRESHOLD_ERROR_RATE_PERCENT=5.0
ALERT_THRESHOLD_RESPONSE_TIME_SECONDS=3.0
ALERT_THRESHOLD_COST_THRESHOLD_USD=10.0
ALERT_THRESHOLD_CPU_THRESHOLD_PERCENT=80.0
ALERT_THRESHOLD_MEMORY_THRESHOLD_PERCENT=85.0
ALERT_THRESHOLD_DISK_THRESHOLD_PERCENT=90.0

# =============================================================================
# Security Configuration (REQUIRED)
# =============================================================================

# JWT Secret for session management
JWT_SECRET=your_super_secure_jwt_secret_here_minimum_32_characters

# Encryption key for sensitive data
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=https://learn-with-ai.vercel.app,https://your-custom-domain.com

# =============================================================================
# Application Configuration
# =============================================================================

# API Configuration
API_TITLE=AI System Design Learning Platform API
API_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Performance Settings
MAX_REQUEST_SIZE=10485760  # 10MB
REQUEST_TIMEOUT=30
WORKER_CONNECTIONS=1000

# Feature Flags
ENABLE_VOICE_FEATURES=true
ENABLE_DIAGRAM_GENERATION=true
ENABLE_ASSESSMENT_SYSTEM=true
ENABLE_PROGRESS_TRACKING=true

# =============================================================================
# Frontend Configuration (for reference)
# =============================================================================

# Next.js Configuration
NEXT_PUBLIC_API_URL=https://your-backend.vercel.app
NEXT_PUBLIC_FRONTEND_URL=https://learn-with-ai.vercel.app
NEXT_PUBLIC_ENVIRONMENT=production

# Analytics
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token_here

# =============================================================================
# External Service Configuration (OPTIONAL)
# =============================================================================

# Sendgrid for email notifications
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@learn-with-ai.com

# Stripe for payments (future)
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# Development and Testing (for reference)
# =============================================================================

# Test Database (separate from production)
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/test_db

# Test API Keys (use test/sandbox keys)
TEST_OPENAI_API_KEY=your_test_openai_key
TEST_GOOGLE_API_KEY=your_test_google_key

# =============================================================================
# Deployment Configuration
# =============================================================================

# Vercel Configuration
VERCEL_TOKEN=your_vercel_deployment_token
VERCEL_ORG_ID=your_organization_id
VERCEL_PROJECT_ID=your_project_id

# Build Configuration
NODE_VERSION=18.x
PYTHON_VERSION=3.11

# =============================================================================
# Backup and Recovery
# =============================================================================

# Database Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM UTC

# Disaster Recovery
DR_REGION=us-west-2
ENABLE_POINT_IN_TIME_RECOVERY=true

# =============================================================================
# Compliance and Privacy
# =============================================================================

# GDPR Compliance
ENABLE_DATA_ANONYMIZATION=true
DATA_RETENTION_DAYS=365
ENABLE_RIGHT_TO_BE_FORGOTTEN=true

# Privacy Settings
ENABLE_AUDIT_LOGGING=true
PII_DETECTION_ENABLED=true
DATA_ENCRYPTION_AT_REST=true